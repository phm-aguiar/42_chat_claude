# Servidor
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://chat:banana42@localhost:5432/chat?sslmode=disable
POSTGRES_USER=chat
POSTGRES_PASSWORD=banana42
POSTGRES_DB=chat

# JWT — OBRIGATÓRIO em produção (mínimo 32 chars aleatórios)
JWT_SECRET=change-me-in-production-use-random-32-chars

# OAuth2 42 Intra — obter em profile.intra.42.fr/oauth/applications
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URI=http://localhost:5173
FORTYTWO_API_URL=https://api.intra.42.fr

# Dev Mode (nunca true em produção)
DEV_MODE=false
DEV_USER=marvin

# WebSocket — OBRIGATÓRIO em produção (ex: https://chat.42sp.org.br)
WS_ALLOWED_ORIGINS=*

# Fórum — ID inteiro do admin inicial (da API 42)
FORUM_ADMIN_ID=

# Frontend (Vite — prefixo VITE_)
VITE_DEV_MODE=false
VITE_API_URL=
VITE_42_CLIENT_ID=dev-client-id
VITE_42_REDIRECT_URI=http://localhost:5173
