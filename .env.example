# Backend (Go + Server)

## Server Configuration
PORT=8080

## Database
DATABASE_URL=postgres://chat:your-db-password-here@localhost:5432/chat?sslmode=disable
POSTGRES_USER=chat
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_DB=chat

## Authentication (OAuth2 42 Intra)
JWT_SECRET=your-secret-key-here
FORTYTWO_CLIENT_ID=your-42-client-id
FORTYTWO_CLIENT_SECRET=your-42-client-secret
FORTYTWO_REDIRECT_URI=http://localhost:9999/callback
FORTYTWO_API_URL=https://api.intra.42.fr

## Development
DEV_MODE=false
DEV_USER=marvin

## WebSocket
WS_ALLOWED_ORIGINS=*

## Forum
FORUM_ADMIN_ID=

# Frontend (React + Vite)
# Note: VITE_* vars are injected via Nginx Dockerfile args during build.
# In development, set them in .env.local (not committed).

## Authentication
VITE_42_CLIENT_ID=your-42-client-id
VITE_42_REDIRECT_URI=http://localhost:9999/callback
VITE_API_URL=http://localhost:9999

## Development Mode
# IMPORTANT: VITE_DEV_MODE must be synchronized with DEV_MODE (backend).
# When developing locally, set both to 'true' to enable dev login (/api/auth/dev/login).
VITE_DEV_MODE=false
